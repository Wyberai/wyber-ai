# ── Dodo Payments (primary payment processor) ─────────────────
# Dashboard → Developers → API Keys
DODO_PAYMENTS_API_KEY=sk_live_...
# Dashboard → Developers → Webhooks → add endpoint → copy signing secret
# Webhook URL: https://wyberai.com/api/dodo/webhook
DODO_WEBHOOK_SECRET=whsec_...

# ── Dodo Subscription Products (8 total) ─────────────────────
# For each: Dodo Dashboard → Products → New Product → Subscription → copy Product ID
# Monthly plans
DODO_PRODUCT_BUILDER=prd_...          # Builder  $99/mo
DODO_PRODUCT_OPERATOR=prd_...         # Operator $249/mo
DODO_PRODUCT_FOUNDER=prd_...          # Founder  $499/mo
DODO_PRODUCT_SCALE=prd_...            # Scale    $999/mo
# Annual plans (set price = monthly_annual_price × 12)
DODO_PRODUCT_BUILDER_ANNUAL=prd_...   # Builder  $79/mo billed annually
DODO_PRODUCT_OPERATOR_ANNUAL=prd_...  # Operator $199/mo billed annually
DODO_PRODUCT_FOUNDER_ANNUAL=prd_...   # Founder  $399/mo billed annually
DODO_PRODUCT_SCALE_ANNUAL=prd_...     # Scale    $799/mo billed annually

# ── Dodo One-Time Top-Up Products (3 total) ──────────────────
# For each: Dodo Dashboard → Products → New Product → One-time → copy Product ID
DODO_TOPUP_300=prd_...    # Boost  pack  300 credits  $24
DODO_TOPUP_900=prd_...    # Power  pack  900 credits  $59
DODO_TOPUP_2000=prd_...   # Studio pack 2000 credits $119

