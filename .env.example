# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── WorkOS (Enterprise SSO — optional, routes 501 until set) ──
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ── Encryption (generate with: openssl rand -hex 32) ──────────
CREDENTIAL_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY=
ADMIN_SECRET_KEY=wyber-admin-2026

# ── Dodo Payments (primary payment processor) ─────────────────
# Dashboard → Developers → API Keys
DODO_PAYMENTS_API_KEY=sk_live_...
# Dashboard → Developers → Webhooks → add endpoint → copy signing secret
# Webhook URL: https://wyberai.com/api/dodo/webhook
DODO_WEBHOOK_SECRET=whsec_...

# ── Dodo Subscription Products (10 total) ────────────────────
# For each: Dodo Dashboard → Products → New Product → Subscription → copy Product ID
# Monthly plans
DODO_PRODUCT_STARTER=prd_...          # Starter  $29/mo   (150 credits)
DODO_PRODUCT_BUILDER=prd_...          # Builder  $79/mo   (500 credits)
DODO_PRODUCT_PRO=prd_...              # Pro      $199/mo  (1,500 credits)
DODO_PRODUCT_GROWTH=prd_...           # Growth   $399/mo  (4,000 credits)
DODO_PRODUCT_SCALE=prd_...            # Scale    $799/mo  (10,000 credits)
# Annual plans (set price = monthly_annual_price × 12)
DODO_PRODUCT_STARTER_ANNUAL=prd_...   # Starter  $23/mo billed annually
DODO_PRODUCT_BUILDER_ANNUAL=prd_...   # Builder  $63/mo billed annually
DODO_PRODUCT_PRO_ANNUAL=prd_...       # Pro      $159/mo billed annually
DODO_PRODUCT_GROWTH_ANNUAL=prd_...    # Growth   $319/mo billed annually
DODO_PRODUCT_SCALE_ANNUAL=prd_...     # Scale    $639/mo billed annually

# ── Dodo One-Time Top-Up Products (3 total) ──────────────────
# For each: Dodo Dashboard → Products → New Product → One-time → copy Product ID
DODO_TOPUP_200=prd_...    # Boost  pack  200 credits  $19
DODO_TOPUP_600=prd_...    # Power  pack  600 credits  $49
DODO_TOPUP_2000=prd_...   # Studio pack 2000 credits  $99

# ── Dodo "Pay What You Want" Products (variable price, amount overridden per-checkout) ──
DODO_PRODUCT_DOMAIN=prd_...       # Custom domain purchases (see src/app/api/domain/purchase)
DODO_PRODUCT_MARKETPLACE=prd_...  # Marketplace app purchases (see src/app/api/marketplace/checkout)

# ── India (INR) pricing — smart-localized, UPI-enabled ───────
# Create these as SEPARATE Dodo products with currency = INR (that's what
# unlocks UPI/RuPay). Prices are India price points, NOT an FX conversion.
# Then flip NEXT_PUBLIC_INR_PRICING_ENABLED=true to show INR + the currency
# toggle. Any unset key falls back to the USD product so checkout never breaks.
NEXT_PUBLIC_INR_PRICING_ENABLED=false
DODO_PRODUCT_SPARK_INR=prd_...          # Spark    ₹499/mo    (50 credits, India-only entry)
DODO_PRODUCT_SPARK_ANNUAL_INR=prd_...   # Spark    ₹399/mo billed annually
DODO_PRODUCT_STARTER_INR=prd_...        # Starter  ₹1,499/mo  (150 credits)
DODO_PRODUCT_BUILDER_INR=prd_...        # Builder  ₹3,999/mo  (500 credits)
DODO_PRODUCT_PRO_INR=prd_...            # Pro      ₹9,999/mo  (1,500 credits)
DODO_PRODUCT_STARTER_ANNUAL_INR=prd_... # Starter  ₹1,199/mo billed annually
DODO_PRODUCT_BUILDER_ANNUAL_INR=prd_... # Builder  ₹3,199/mo billed annually
DODO_PRODUCT_PRO_ANNUAL_INR=prd_...     # Pro      ₹7,999/mo billed annually
DODO_TOPUP_200_INR=prd_...              # Boost  pack  200 credits  ₹399
DODO_TOPUP_600_INR=prd_...              # Power  pack  600 credits  ₹999
DODO_TOPUP_2000_INR=prd_...             # Studio pack 2000 credits  ₹1,999

# ── Resend (email) ────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Composio (agent tool connections) ────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=

# ── GitHub OAuth (GitHub sync feature) ───────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Vercel (deploy feature) ───────────────────────────────────
VERCEL_TOKEN=...

# ── AI Employee: Voice output (optional, either key enables TTS) ─
ELEVENLABS_API_KEY=        # ElevenLabs TTS (preferred)
OPENAI_API_KEY=            # OpenAI TTS fallback

# ── AI Employee: Browser control (optional) ──────────────────
BROWSERBASE_API_KEY=       # Browserbase.com — enables fill_form / click / screenshot
BROWSERBASE_PROJECT_ID=    # Browserbase project ID

# ── GTM Integrations (optional) ──────────────────────────────
HUBSPOT_ACCESS_TOKEN=      # HubSpot CRM sync
SALESFORCE_INSTANCE_URL=   # Salesforce instance URL (e.g. https://na1.salesforce.com)
SALESFORCE_ACCESS_TOKEN=   # Salesforce OAuth access token
SMARTLEAD_API_KEY=         # Smartlead.ai email warmup

# ── Google Cloud ──────────────────────────────────────────────
# Template CDN cache (optional — falls back to Supabase)
GCS_TEMPLATE_BUCKET=wyberai-templates
GCS_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# Vertex AI Gemini fallback (used when Anthropic is down/slow)
# Get from: console.cloud.google.com → APIs → Generative Language API → Credentials → API Key
GOOGLE_AI_API_KEY=AIza...

# ── App config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://wyberai.com
NEXT_PUBLIC_APP_NAME=WyberAi
NEXT_PUBLIC_APP_EMAIL=hello@wyberai.com
CRON_SECRET=generate-a-random-32-byte-hex-string

# ── Meta (Facebook/Instagram) Ads tracking ───────────────────
# Without these the Pixel + Conversions API are inert (no-op) — set them
# before running Meta ads or the campaign can't track/optimize conversions.
#   NEXT_PUBLIC_META_PIXEL_ID  → Events Manager › Data sources › your Pixel ID
#   META_PIXEL_ID              → same numeric id, server-side (CAPI)
#   META_CAPI_TOKEN            → Events Manager › Settings › Conversions API
#                                › Generate access token
#   META_TEST_EVENT_CODE       → optional; set while validating in Test Events
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ── Supabase Storage Buckets to create (public) ──────────────
# employee-voice-clips  (AI Employee voice output clips)


# ── Appetize Real-Device Preview ─────────────────────────────
# Get from https://appetize.io/account → API token
APPETIZE_API_TOKEN=tok_...
# Webhook auth secret — generate with: openssl rand -hex 32
APPETIZE_WEBHOOK_SECRET=...
# Shared secret for the files endpoint called by GitHub Actions
APPETIZE_BUILD_SECRET=...

# ── GitHub Actions Build Pipeline (for Appetize) ─────────────
# PAT (classic) with repo + workflow scopes
# (or a fine-grained PAT with Actions: Read/Write on your build repo)
GITHUB_BUILD_TOKEN=ghp_...
# Format: owner/repo  e.g. wyberai/mobile-builds
GITHUB_BUILD_REPO=wyberai/mobile-builds
