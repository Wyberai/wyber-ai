# Dashboard → Developers → Webhooks → signing secret
DODO_WEBHOOK_SECRET=whsec_...

# ── Dodo Subscription Products (6 total) ─────────────────────
# Create each as a SUBSCRIPTION product in Dodo → copy Product ID
DODO_PRODUCT_STARTER=prd_...         # Starter Monthly  $49/mo
DODO_PRODUCT_STARTER_ANNUAL=prd_...  # Starter Annual   $39/mo billed annually
DODO_PRODUCT_GROWTH=prd_...          # Growth Monthly   $149/mo
DODO_PRODUCT_GROWTH_ANNUAL=prd_...   # Growth Annual    $119/mo billed annually
DODO_PRODUCT_SCALE=prd_...           # Scale Monthly    $399/mo
DODO_PRODUCT_SCALE_ANNUAL=prd_...    # Scale Annual     $319/mo billed annually

# ── Dodo One-Time Top-Up Products (3 total) ──────────────────
# Create each as a ONE-TIME payment product in Dodo → copy Product ID
DODO_TOPUP_200=prd_...   # Boost pack  200 credits  $19
DODO_TOPUP_600=prd_...   # Power pack  600 credits  $49
DODO_TOPUP_2000=prd_...  # Studio pack 2000 credits $149

