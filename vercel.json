{
  "crons": [
    {
      "path": "/api/cron/daily-credits",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/agent-scheduler",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/wyber-preview-sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/wyber-preview/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
