{
  "crons": [
    {
      "path": "/api/cron/daily-credits",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/agent-scheduler",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/mcp-consumer",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/employee-scheduler",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/email-drip",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/security-rescan",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/wyber-preview-sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/wyber-preview/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
